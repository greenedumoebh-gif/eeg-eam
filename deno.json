{
  "name": "eeg-eam",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv src/main.ts",
    "seed": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv src/seed.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write --unstable-kv",
    "check": "deno check src/main.ts src/seed.ts && deno lint && deno fmt --check",
    "bundle": "deno bundle --platform deno --keep-names -o dist/main.js src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "unstable": [
    "kv"
  ]
}
